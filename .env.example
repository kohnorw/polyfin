# Copy to .env and set POSTGRES_PASSWORD. Never commit .env.
#
# Compose places the password inside a PostgreSQL URL, so keep it URL-safe.
# Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional, advised: encrypts the API keys, client secret and tracking
# tokens Polyfin stores in the database. 32 random bytes in base64, made with
# `openssl rand -base64 32`. Keep it with your backups: without it, they have
# to be entered again.
# POLYFIN_SECRET_KEY=

# The image Compose runs: the one your fork publishes (see
# .github/workflows/docker.yml), e.g. ghcr.io/<your-github-user>/polyfin:latest.
POLYFIN_IMAGE=
